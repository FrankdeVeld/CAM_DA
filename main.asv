clear
close all
clc
addpath(genpath('.\Functions'))

%% Initialisation

%Parameters
params = struct( ...
    'ctrlMax_dim', 1e-8, ...
    'md_lim_dim',  1, ...
    'pocLim', 1e-6, ... 
    'nx_orb', 30, ...
    'n_orb', 1, ...
    'breakOnThreshold', 1, ...
    'metric_case', 2 ...
    );

% Scenario definition
[primary,secondary] = generateInitShort(1);
scenario            = nondimensionalise(primary,secondary,params);

% Write json input
input = write_input(scenario, params);

%% Optimisation
!wsl ./build/bin/backSweep

[control, rB, tca_shift, md, smd] = readBackSweepOutput('output.json');

%% Validation and postprocessing
[rB_val, md_val, smd_val, poc] = validateBackSweep('output.json');
rB_val(rB_val==0) = nan;
rB(rB==0)         = nan;
% figure
% plot(tca_shift*Tsc)
% hold on
% plot(dtca*Tsc)
% hold off

figure
plot(control)
legend('R','T','N')

figure
plot(sqrt(md)*input.Lsc)
hold on
plot(md_val*input.Lsc)
plot(scenario.md_lim_d *ones(2,1),[0,N],'k--')
hold off

figure
semilogy(poc)
ylim([1e-10,1e-2])


figure
plot(smd)
hold on
plot(smd_val)
plot(scenario.smdLim*ones(2,1),[0,N],'k--')
hold off

showEllipseBplane(scenario.Pb,input.lim,rB,rB_val,input.metric_case,input.Lsc);